# =============================================================
# ProMarkah — .htaccess
# Performance: Efficient Cache Lifetimes + Image Delivery
# =============================================================

# ── Enable mod_expires (Cache-Control / Expires headers) ─────
<IfModule mod_expires.c>
    ExpiresActive On

    # Default fallback — 1 hour
    ExpiresDefault "access plus 1 hour"

    # ── Images ───────────────────────────────────────────────
    # Long cache: images change rarely; bust with filename versioning
    # e.g. logo_silat_1.v2.webp when you update them.
    ExpiresByType image/jpeg    "access plus 1 year"
    ExpiresByType image/png     "access plus 1 year"
    ExpiresByType image/webp    "access plus 1 year"
    ExpiresByType image/gif     "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon  "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # ── Fonts ────────────────────────────────────────────────
    ExpiresByType font/woff     "access plus 1 year"
    ExpiresByType font/woff2    "access plus 1 year"
    ExpiresByType application/font-woff  "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # ── CSS & JavaScript ─────────────────────────────────────
    # 1 year. Use query string versioning: output.css?v=3 to bust.
    ExpiresByType text/css              "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript       "access plus 1 year"

    # ── HTML / PHP (dynamic) — never cache ───────────────────
    ExpiresByType text/html             "access plus 0 seconds"
    ExpiresByType application/x-httpd-php "access plus 0 seconds"
</IfModule>

# ── Supplement with Cache-Control headers ────────────────────
<IfModule mod_headers.c>

    # Remove Pragma on cacheable assets
    <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico|woff|woff2|css|js)$">
        Header unset Pragma
        Header append Cache-Control "public, immutable"
    </FilesMatch>

    # Ensure PHP pages are never stale-served from a proxy
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>

</IfModule>

# ── Serve WebP images to browsers that support them ──────────
# (Requires mod_rewrite + mod_setenvif)
# This lets you keep .png originals and auto-serve .webp when available.
# Place matching .webp files alongside your .png/.jpg files.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Only rewrite if the browser accepts webp AND a .webp file exists
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.webp -f
    RewriteRule ^(img/.+)\.(png|jpg|jpeg)$ $1.webp [T=image/webp,E=accept:1,L]

    # Also match requests already ending in .png/.jpg from the img/ folder
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_FILENAME}.webp -f
    RewriteRule ^(.*)\.(png|jpg|jpeg)$ $1.webp [T=image/webp,L]
</IfModule>

# Ensure WebP is sent with the correct Vary header so CDNs cache correctly
<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpg|jpeg)$">
        Header append Vary Accept
    </FilesMatch>
</IfModule>

# ── Enable Gzip / Brotli compression ─────────────────────────
# Compresses HTML, CSS, JS on-the-fly — further reduces transfer size.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
    AddOutputFilterByType DEFLATE text/plain text/xml application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
