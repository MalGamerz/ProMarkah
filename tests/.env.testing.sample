# Copy to tests/.env.testing (gitignored) to enable the Http test suite.
# Without this file, `composer test:http` / `phpunit --testsuite Http` skips
# every test rather than failing — see tests/Support/HttpTestCase.php.
#
# NEVER point TEST_BASE_URL at the live production site, and NEVER use real
# staff credentials here — create disposable test accounts (one per role)
# in a local/staging DB instead. These tests submit real logins, real bad
# logins, and real (CSRF-rejected) POSTs; the Http suite never intentionally
# writes data that survives, but it is still live HTTP traffic, not a mock.

TEST_BASE_URL=http://promarkah-v3.test

TEST_PIC_USERNAME=
TEST_PIC_PASSWORD=

TEST_ADMIN_USERNAME=
TEST_ADMIN_PASSWORD=

TEST_RECORDER_USERNAME=
TEST_RECORDER_PASSWORD=

# Judge login is two-step (see README.md "Login & auth model"): a
# username+password account for step 1, then a judge_id + PIN for step 2.
TEST_JUDGE_USERNAME=
TEST_JUDGE_PASSWORD=
TEST_JUDGE_ID=
TEST_JUDGE_PIN=
